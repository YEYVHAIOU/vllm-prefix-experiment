# Shared configuration for final V/U/C/F benchmark.
HOST=127.0.0.1
PORT=8000

MODEL_NAME=Qwen/Qwen3-0.6B
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.80
SWAP_SPACE_GIB=1

VENV_PATH="${VENV_PATH:?Set VENV_PATH to the vLLM virtual environment}"
MODEL_PATH="${MODEL_PATH:?Set MODEL_PATH to the local Qwen3-0.6B model directory}"

CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-12.8}"
LD_PRELOAD="${LD_PRELOAD:-/usr/lib/x86_64-linux-gnu/libstdc++.so.6}"

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=123456
VLLM_LOGGING_LEVEL=INFO

# Final Continuum configuration. Only semantically active for C/F.
CONTINUUM_TTL_CDF_IMPL=optimized
CONTINUUM_HISTORY_THRESHOLD=5
CONTINUUM_DEFAULT_TTL_SECONDS=2.0
CONTINUUM_PREFILL_PROFILE_SCALE=1.0
CONTINUUM_TTL_TIMING_INTERVAL=0

# Shared UCM transfer/tier configuration. Only active for U/F.
UCM_PRESSURE_THRESHOLD=0.65
UCM_JOINT_HIGH_THRESHOLD=0.90
UCM_JOINT_AFTER_TTL_THRESHOLD=0.50
UCM_DUMP_COST_INTERCEPT_MS=2.8000
UCM_DUMP_COST_PER_BLOCK_MS=1.5005
UCM_LOAD_COST_INTERCEPT_MS=0.3510
UCM_LOAD_COST_PER_BLOCK_MS=0.3345
UCM_TIER_DRAM_MIB=128
UCM_TIER_STREAM_NUMBER=2
UCM_TIER_BUFFER_NUMBER=64
UCM_TIER_USE_DIRECT=false
UCM_TRANSFER_PROFILE=0

# Capacity/pilot workload settings. These preserve the historical capacity
# campaign semantics used for C96/C128.
BENCH_DURATION_SCALE=0.01
BENCH_MAX_SLEEP_SECONDS=2
BENCH_MAX_OUTPUT_TOKENS=8
BENCH_METRICS_INTERVAL=0.2
BENCH_REQUEST_TIMEOUT=300
BENCH_LOG_FLUSH_WAIT=2
BENCH_HTTP_MODE=httpclient_per_lane
BENCH_LANE_ASSIGNMENT=balanced
BENCH_RESET_AWARE_PREFIX=0
